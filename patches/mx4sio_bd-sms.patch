+/* Bounded spin for the SIO2 "transfer complete" status bit (stat6c bit 12).
+ *
+ * The original code spun on this bit with NO bound -- including inside the DMA
+ * completion ISR (interrupts masked) and inside the per-byte PIO helpers. If a
+ * single SIO2 transfer ever stalls (e.g. bus contention while the host polls the
+ * controller), those spins never return and lock the entire IOP -> hard freeze
+ * that no thread-level watchdog can break. A real transfer completes in
+ * microseconds, far below this cap, so bounding it only ever fires on a genuine
+ * stall, turning a permanent freeze into a recoverable error. Returns 1 on
+ * completion, 0 on timeout. */
+#define SIO2_XFER_DONE_MAX 0x10000
+static int mx_sio2_xfer_done(void)
+{
+    uint32_t guard = SIO2_XFER_DONE_MAX;
+    while ((inl_sio2_stat6c_get() & (1 << 12)) == 0) {
+        if (--guard == 0)
+            return 0;
+    }
+    return 1;
+}
